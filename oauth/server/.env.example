# Public HTTPS origin of this server. Use http://localhost only for local development.
APP_ORIGIN=https://your-server.example.com
PORT=3000

# Must match the id in oauth/manifest.json.
FIGMA_PLUGIN_ID=oauth-sample

# OAuth 2.0 authorization-code application settings.
OAUTH_AUTHORIZE_URL=https://provider.example.com/oauth/authorize
OAUTH_TOKEN_URL=https://provider.example.com/oauth/token
OAUTH_CLIENT_ID=replace-with-client-id
OAUTH_CLIENT_SECRET=replace-with-client-secret
OAUTH_REDIRECT_URI=https://your-server.example.com/oauth/callback
OAUTH_SCOPE=
OAUTH_USE_PKCE=true
OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
